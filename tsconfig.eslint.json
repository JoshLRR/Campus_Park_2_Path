{
  "extends": "./tsconfig.json",
  "include": [
    "src",
    "src/**/*.ts",
    "src/**/*.tsx",
    "vite.config.ts",
    "vitest.config.ts",
    "vitest.stryker.config.ts",
    "**/*.json",
    "database/**/*.ts",
    "backend/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "coverage"
  ],
  "compilerOptions": {
    "resolveJsonModule": true
  }
}
