{
  "extends": "./node_modules/gts/tsconfig-google.json",
  "compilerOptions": {
    "lib": ["ES2020"],
    "rootDir": ".",
    "outDir": "build/server",
    "module": "Node16",
    "moduleResolution": "node16",
    "resolveJsonModule": true,
    "esModuleInterop": true
  },
  "include": ["server/**/*.ts", "src/**/*.ts"],
  "exclude": ["src/**/*.tsx", "src/__tests__/**", "**/*.test.ts", "**/*.test.tsx"]
}
