{
  "extends": "./node_modules/gts/tsconfig-google.json",
  "compilerOptions": {
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "jsx": "react-jsx",
    "rootDir": ".",
    "outDir": "build",
    "module": "Node16",
    "moduleResolution": "node16",
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "types": ["node", "vitest/globals"]
  },
  "include": [
    "src",
    "src/**/*.ts",
    "src/**/*.tsx",
    "src/**/*.json",
    "server",
    "server/**/*.ts",
    "database",
    "database/**/*.ts",
    "database/**/*.json"
  ],
  "exclude": [
  "build",
  "node_modules",
  "src/__tests__/**"
]
}