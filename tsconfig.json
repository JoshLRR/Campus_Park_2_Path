{
  "extends": "./node_modules/gts/tsconfig-google.json",
  "compilerOptions": {
    "lib": ["dom", "dom.iterable", "es2022"],
    "jsx": "react-jsx",
    "rootDir": ".",
    "outDir": "build",
    "module": "Node16",
    "moduleResolution": "node16"
  },
  "include": ["src/**/*.ts", "src/**/*.tsx"],
  "exclude": ["src/__tests__/**", "**/*.test.ts", "**/*.test.tsx"]
}
